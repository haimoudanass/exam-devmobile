# Firebase Cloud Messaging (service account JSON path, relative to project root)
FIREBASE_CREDENTIALS=storage/app/firebase-auth.json

GEMINI_API_KEY=

# Copy to .env and set DB_PASSWORD for PostgreSQL

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=smartcity
DB_USERNAME=postgres
DB_PASSWORD=
